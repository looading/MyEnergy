MYENERGY_HOST=127.0.0.1
MYENERGY_PORT=8787
MYENERGY_DATABASE=./data/myenergy.sqlite
# Production: comma-separated App ID audiences configured in your Apple team.
MYENERGY_APPLE_AUDIENCES=dev.myenergy.ios,dev.myenergy.mac
# Development accounts are forbidden when binding a non-loopback address.
MYENERGY_ALLOW_DEV_AUTH=0

# Used by both Compose and the native Node process.
# Comma-separated Apple token audiences as configured in your Apple team.
MYENERGY_APPLE_AUDIENCES=
# Host port for Compose, or the listen port of the native Node process.
MYENERGY_PORT=8787

# Compose only: address where Docker publishes the host port.
MYENERGY_BIND_ADDRESS=127.0.0.1

# Native Node process only. Compose fixes these values for the container.
MYENERGY_HOST=127.0.0.1
MYENERGY_DATABASE=./data/myenergy.sqlite
# Development accounts are forbidden when binding a non-loopback address.
MYENERGY_ALLOW_DEV_AUTH=0
